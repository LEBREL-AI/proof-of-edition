{
  "targets": [
    {
      "name": "deepseek/api",
      "model": "deepseek-v4.1-flash",
      "base_url": "https://api.deepseek.com/v1",
      "upstream_model": "deepseek-flash",
      "api_key_env": "DEEPSEEK_API_KEY",
      "notes": "the lab's own API; deepseek-flash is the current V4.1 Flash alias; thinking disabled so answers are comparable; floor measured on the same deployment, runs 20260923T214043Z vs 20260924T015801Z: 0.40 exact, 0.62 prefix, sampled test agrees",
      "body": {
        "thinking": {
          "type": "disabled"
        }
      },
      "thresholds": {
        "min_exact_rate": 0.3,
        "min_prefix_agreement": 0.5
      }
    },
    {
      "name": "deepseek/api-thinking",
      "model": "deepseek-v4.1-flash/thinking",
      "base_url": "https://api.deepseek.com/v1",
      "upstream_model": "deepseek-flash",
      "api_key_env": "DEEPSEEK_API_KEY",
      "overrides": {
        "max_tokens": 2048
      },
      "notes": "the lab's own API in its native mode: thinking on at high effort, as a client gets it by default; its own family so it is compared with itself over time; floor measured on the same deployment, runs 20260923T214043Z vs 20260924T015801Z: 0.15 exact, 0.29 prefix, sampled test agrees; in reasoning mode the temperature-0 answers vary with the chain of thought, so the deterministic test is weak and the sampled test carries the verdict",
      "thresholds": {
        "min_exact_rate": 0.1,
        "min_prefix_agreement": 0.2
      }
    },
